# .env.production.example - Template Konfigurasi Produksi Linux/VPS (T-4.5)
NODE_ENV=production
PORT=3000
DATABASE_URL="file:/opt/artatrade/data/artatrade.db"

# Mode Keamanan ARM (DEFAULT HARUS false)
ARM_ENABLED=false

# Kredensial Binance Futures (Disimpan HANYA di server)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
# LIVE akan fail-closed sampai integrasi akun/ledger selesai; jangan aktifkan untuk trading riil.
BINANCE_EXECUTION_MODE=PAPER

# Binance Endpoints & WebSocket Pools
BINANCE_REST_POOL="fapi.binance.com,fapi1.binance.com,fapi2.binance.com,fapi3.binance.com,fapi4.binance.com"
BINANCE_WS_PRIMARY="fstream.binance.com"
BINANCE_WS_FALLBACK="fstream1.binance.com"

# Xkiro LLM Configuration
XKIRO_API_KEY=""
XKIRO_BASE_URL="https://api.xkiro.com/v1"
# Full vendor/model IDs required by the xKiro catalog.
XKIRO_MODEL_FAST="xiaomi/mimo-v2.6-flash"
# REASON handles deeper analysis.
XKIRO_MODEL_REASON="xiaomi/mimo-v2.6-pro"
XKIRO_MODEL_REASON_FALLBACKS=""
XKIRO_REASONING_EFFORT="xhigh"
XKIRO_MONTHLY_BUDGET_USD=60.0
XKIRO_DEGRADE_AT_PCT=80.0

# TradingView Webhook Secret
TV_WEBHOOK_SECRET=""

# Saklar lane SWING (true = dua lane; false = SCALP-only)
SWING_ENABLED=true

# Logging & Monitoring
LOG_LEVEL=info
LOG_DIR="/opt/artatrade/logs"
