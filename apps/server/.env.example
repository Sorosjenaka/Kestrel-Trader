# =====================================================================
# ArtaTrade AI - TEMPLATE ENV (SALIN, JANGAN ISI NILAI DI FILE INI)
# 1) Salin ke apps/server/.env  -> RAHASIA (gitignored); isi key di sana.
# 2) Salin ke apps/web/.env     -> HANYA baris VITE_API_BASE_URL.
# DILARANG menampilkan nilai key di UI, log, chat, atau dokumen.
# =====================================================================

# ---------- SERVER (apps/server/.env) ----------
PORT=8787
DB_PATH=./data/artatrade.db
DATABASE_URL=file:../data/artatrade.db
LOG_LEVEL=info

# Binance USDT-M Futures - diisi SENDIRI oleh operator (read+trade; tanpa withdraw)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# PAPER tetap memakai executor simulasi. LIVE saat ini fail-closed sampai integrasi akun/ledger selesai.
BINANCE_EXECUTION_MODE=PAPER
BINANCE_REST_POOL=fapi.binance.com,fapi1.binance.com,fapi2.binance.com,fapi3.binance.com,fapi4.binance.com
BINANCE_WS_PRIMARY=fstream.binance.com
BINANCE_WS_FALLBACK=fstream1.binance.com

# Xkiro (satu-satunya provider LLM; simpan key hanya di .env lokal)
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
# Full vendor/model IDs required by the xKiro catalog.
# FAST handles lightweight calls; REASON handles deeper analysis.
XKIRO_MODEL_FAST=xiaomi/mimo-v2.6-flash
XKIRO_MODEL_REASON=xiaomi/mimo-v2.6-pro
XKIRO_MODEL_REASON_FALLBACKS=
XKIRO_REASONING_EFFORT=xhigh
# 0 = no local app spending limit; Xkiro provider billing still applies.
XKIRO_MONTHLY_BUDGET_USD=0
XKIRO_DEGRADE_AT_PCT=80

# Aturan uang (ubah hanya via ParameterVersion + gate backtest)
RISK_PER_TRADE_USD=1
LEVERAGE_TARGET=25
# Mode margin Binance Futures: CROSS (perintah operator) / ISOLATED.
MARGIN_MODE=CROSS
MARGIN_CAP_PCT=40
# 29 Sep 2026 — perintah operator: DAILY_STOP_USD & AUTO_DISARM_DD_USD DIHAPUS dari sistem.
# Tidak ada lagi guard rugi harian / auto-disarm drawdown; PnL tetap dilaporkan untuk observabilitas.
# ARM OTOMATIS ON (perintah operator): bot yang berjalan = bersenjata. Matikan via TURU.
ARM_DEFAULT=true

# Eksplorasi progresif (28 Sep 2026): ga ketat dulu, LLM nilai semua, ambang naik
# bertahap L0(45) -> L5(68) saat bukti PAPER membaik. 0..5 = kunci level,
# AUTO = dari jumlah/winrate/expectancy trade terverifikasi. false = ketat L5.
PROGRESSIVE_ENABLED=true
PROGRESSIVE_LEVEL_OVERRIDE=AUTO
# Outage LLM (provider 402): vonis deterministik berlabel agar screening tetap
# bisa entry saat semua agen gagal; pulih otomatis saat LLM menjawab. PAPER-only.
DETERMINISTIC_FALLBACK_ON_LLM_OUTAGE=true
# Allowlist strategi SCALP (renumber 29 Sep 2026): S-01 Squeeze Breakout,
# S-03 Liquidity Sweep Reclaim, S-05 HA Smooth Scalper — semuanya trigger nyata
# di TF 1m/3m/5m. SWING tetap S-02 FVG Continuation + S-04 Liquidity Sniper.
# 1 Okt 2026 — operator: hanya 2 strategi aktif (Strategi 1 = S-03 Sweep Reclaim, Strategi 2 = S-04 Liquidity Sniper).
# 20 Okt 2026 — katalog aktif final: SCALP = S-02 (Liquidity Sniper) saja;
# S-01 Liquidity Sweep Reclaim tetap hard-gated (EV negatif).
# 21 Okt 2026 (Phase 4e): align dengan .env produksi.
SCALP_STRATEGY_IDS=S-02
# Saklar lane SWING (perintah operator 29 Sep 2026). Katalog aktif 21 Okt 2026:
# SWING = RSW-01 (Orion), RSW-02 (Vega), RSW-03 (Draco). S-05 Polaris diarsipkan
# 21 Okt 2026 (entry retired 20 Okt 2026, edge negatif).
SWING_STRATEGY_IDS=RSW-01,RSW-02,RSW-03
# Saklar lane SWING (perintah operator 29 Sep 2026): false = mode SCALP-only.
# Saat false, allowlist SWING kosong dan lane SWING tidak dievaluasi.
SWING_ENABLED=true
# Filter & scanner
VOLUME_MIN_USD=7000000
# Worker paralel analisis MTF. JANGAN menaikkan melewati cap: 12 paralel memicu
# 429 Binance sehingga semua kandidat jatuh ke Jalur B (MTF_UNAVAILABLE, tidak ada
# strategy match). Cap keras 2..3 lewat MTF_CONCURRENCY_CAP.
MTF_CONCURRENCY=3
MTF_CONCURRENCY_CAP=3
SCAN_CONCURRENCY=50
SCAN_INTERVAL_SCALP_SEC=60
SCAN_INTERVAL_SWING_SEC=300
SCALP_HOLD_MAX_MIN=90
SWING_HOLD_MAX_HOUR=12

# SL-fill policy (30 Sep 2026, perintah operator "SL jangan melebar"):
# SL dieksekusi di harga stop + slippage kecil (bps) — bukan di harga pasar saat
# monitor mendeteksi. Loss terkunci ~-1R. 
SL_FILL_SLIPPAGE_BPS=5
# Ambang "fake out yang luar biasa" (× risk distance melewati SL dalam satu tick):
# hanya di atas ambang ini fill mengikuti harga pasar + event audit SL_GAP_FILL.
SL_GAP_OVERRUN_R=2

# TradingView (opsional; akun free -> biarkan OFF)
TV_MCP_ENABLED=false
TV_WEBHOOK_SECRET=

# ---------- DREX (NaceAI) — lapisan keputusan Arka (docs/DREX_INTEGRATION.md) ----------
# Lapisan keputusan, BUKAN risk engine: tidak menghitung harga/ukuran/sizing.
# Tanpa DREX_API_KEY tidak ada panggilan keluar (otomatis failover ke judge Xkiro).
DREX_ENABLED=true
DREX_BASE_URL=https://drex.nace.ai
DREX_MODEL=drex-v1.5
DREX_TIMEOUT_MS=4000
# Ambang probabilitas GO Drex (0..1). JANGAN diturunkan otomatis untuk menambah frekuensi.
DREX_MIN_ENTRY_PROBABILITY=0.55
DREX_MIN_SETUP_STRENGTH=2
# Diisi MANUAL oleh operator; JANGAN commit nilai asli, JANGAN tempel di chat/dokumen.
DREX_API_KEY=


# ---------- Tambahan dari .env live (audit 10 Okt 2026) ----------
# Nilai konfigurasi disamakan dengan .env VPS; key rahasia tetap PLACEHOLDER.
# Catatan: DAILY_STOP_USD & AUTO_DISARM_DD_USD masih ada di .env lama tapi sistem
# sudah tidak memakainya (perintah operator 29 Sep 2026) — disertakan hanya agar lengkap.
AUTO_DISARM_DD_USD=8
BINANCE_ACCOUNT_ID_2=BINANCE_ACCOUNT_ID_HERE
BINANCE_API_KEY_2=BINANCE_API_KEY_2_HERE
BINANCE_ROUTING_STRATEGY=ROUND_ROBIN
BINANCE_SECRET_KEY_2=BINANCE_SECRET_KEY_2_HERE
DAILY_STOP_USD=2
# Path absolut mesin VPS; di mesin lain sesuaikan dengan lokasi repo.
KNN_LIBRARY_PATH=/opt/kestrel/data/knn-library.json
LLM_MAX_CONCURRENCY=4
LLM_RETRY_429_MAX=2
PAPER_DETERMINISTIC_ENTRY=false
# 21 Okt 2026 (Phase 4b/4c): S03_FIB_ENABLED dan S03_SHORT_ENABLED DIHAPUS.
# S-03 (Fibonacci) sudah dihapus dari katalog aktif dan plan-nya fail-closed.
# S-01 SHORT (Liquidity Sweep Reclaim) sekarang TERKUNCI PERMANEN — tidak ada
# env yang bisa membukanya lagi. Guard: isStrategySideLocked().
SIDEWAYS_ENTRY_ALLOWED=false

# --- AI COUNCIL CONFIG ---
# Aktifkan 'true' untuk mengaktifkan validasi multi-agen sebelum entry
ENABLE_AI_COUNCIL=false

# --- JALUR LIVE (keputusan operator 10 Okt 2026) ---
# Fase test $3: 1 posisi, tanpa DD cap, min balance $3. Fase $30 nanti:
LIVE_MAX_OPEN_POSITIONS=1
# BINANCE_EXECUTION_MODE tetap PAPER sampai perintah eksplisit "GO LIVE".
LIVE_MAX_OPEN_POSITIONS=1
LIVE_DAILY_DD_CAP_USD=7
LIVE_MIN_BALANCE_USD=3
LIVE_MAX_MARGIN_USD=3
